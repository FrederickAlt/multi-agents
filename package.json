{
  "name": "persistent-task-subagents",
  "version": "0.1.0",
  "description": "Pi extension for persistent configured sub-agents via the Task tool",
  "type": "module",
  "scripts": {
    "test": "vitest --run",
    "test:watch": "vitest"
  },
  "bin": {
    "pi-agent-config": "./pi-agent-config.ts"
  },
  "files": [
    "subagent/**/*",
    "src/tui/**/*",
    "pi-agent-config.ts",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./subagent/index.ts"
    ]
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typebox": "^1.1.38",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "ink": "^5.2.1",
    "js-yaml": "^4.1.1",
    "react": "^19.2.6"
  }
}
