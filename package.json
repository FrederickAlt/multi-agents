{
  "name": "persistent-task-subagents",
  "version": "0.1.0",
  "description": "Pi extension for persistent configured sub-agents via the Task tool",
  "type": "module",
  "scripts": {
    "check": "biome check --write --error-on-warnings . && tsgo --noEmit",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:llm": "RUN_REAL_LLM_TESTS=1 vitest --run test/task-llm.test.ts",
    "tui:dump": "tsx src/tui/dev/render-scenarios.tsx",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "pi-agent-config": "./src/tui/cli.ts",
    "pi-agents": "./src/launcher/cli.ts"
  },
  "files": [
    "src/**/*",
    "README.md"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.3.5",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.29",
    "@typescript/native-preview": "7.0.0-dev.20260120.1",
    "husky": "^9.1.7",
    "tsx": "^4.19.3",
    "typebox": "^1.1.38",
    "typescript": "^5.9.2",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "ink": "^5.2.1",
    "react": "^18.3.1"
  }
}
