{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "inlineSources": true,
    "inlineSourceMap": false,
    "moduleResolution": "Node16",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    "types": ["node", "vitest/globals"],
    "jsx": "react-jsx",
    "paths": {
      "@mariozechner/pi-ai": ["../pi-mono/packages/ai/src/index.ts"],
      "@mariozechner/pi-ai/oauth": ["../pi-mono/packages/ai/src/oauth.ts"],
      "@mariozechner/pi-ai/*": ["../pi-mono/packages/ai/src/*.ts", "../pi-mono/packages/ai/src/providers/*.ts"],
      "@mariozechner/pi-agent-core": ["../pi-mono/packages/agent/src/index.ts"],
      "@mariozechner/pi-agent-core/*": ["../pi-mono/packages/agent/src/*"],
      "@mariozechner/pi-coding-agent": ["../pi-mono/packages/coding-agent/src/index.ts"],
      "@mariozechner/pi-coding-agent/*": ["../pi-mono/packages/coding-agent/src/*"],
      "@mariozechner/pi-tui": ["../pi-mono/packages/tui/src/index.ts"],
      "@mariozechner/pi-tui/*": ["../pi-mono/packages/tui/src/*"]
    }
  },
  "include": [
    "subagent/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts",
    "test/**/*.tsx",
    "pi-agent-config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules"]
}
